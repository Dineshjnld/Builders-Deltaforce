DELTA_CITY_TOKEN=judge-local-only
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_FALLBACK_MODEL=gpt-4.1-mini
OPENAI_THEME_MODEL=gpt-4.1-mini
DELTA_VOICE_SESSIONS_PER_DAY=24

