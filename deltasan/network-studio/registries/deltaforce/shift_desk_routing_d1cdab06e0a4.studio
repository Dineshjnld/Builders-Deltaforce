{"title":"Shift desk routing","agents":[{"id":"a0","name":"Coordinator","task":"Handle clock queries by delegating to TimeDesk. Delegate requests to review a shift handover to Specialist. Return the specialist result.","tools":[],"x":20,"y":110},{"id":"a1","name":"Specialist","task":"Analyze the assigned request and report findings.","tools":[],"x":330,"y":40},{"id":"a2","name":"TimeDesk","task":"Call the current_time tool for the requested IANA time zone and quote its result exactly.","x":330,"y":260,"tools":["clock"]}],"routes":[{"from":"a0","to":"a1","when":"The user asks to review a shift handover"},{"from":"a0","to":"a2","when":"The user asks for a current date or time"}]}