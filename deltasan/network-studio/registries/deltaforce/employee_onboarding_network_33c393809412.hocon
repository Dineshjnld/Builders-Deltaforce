  "metadata": {
    "description": "Employee Onboarding Network"
  },
  "max_execution_seconds": 120,
  "tools": [
    {
      "name": "Coordinator",
      "function": {
        "description": "Initiate the onboarding process"
      },
      "instructions": "Initiate the onboarding process\nCall HRManager when Coordinate with the employee's department.\nCall DepartmentManager when Provide department-specific information.\nCall ITSupport when Provide technical support during the onboarding process.\nCall Finance when Provide financial information and resources.\nCall Legal when Provide legal advice and resources.\nCall TrainingCoordinator when Coordinate with the training department.\nCall Recruitment when Provide information about the company's culture and values.\nCall OnboardingCoordinator when Coordinate with the other agents.\nUse the assigned tools when the request needs their information.",
      "tools": [
        "HRManager",
        "DepartmentManager",
        "ITSupport",
        "Finance",
        "Legal",
        "TrainingCoordinator",
        "Recruitment",
        "OnboardingCoordinator",
        "http://127.0.0.1:45186/mcp",
        "https://mcp.deepwiki.com/mcp",
        "https://api.you.com/mcp?profile=free",
        "web_fetch"
      ]
    },
