  "metadata": {
    "description": "E-commerce Customer Support Agent Network"
  },
  "max_execution_seconds": 120,
  "tools": [
    {
      "name": "Coordinator",
      "function": {
        "description": "Coordinate and manage the entire network"
      },
      "instructions": "Coordinate and manage the entire network\nCall Agent1 when Provide initial customer support.\nCall Agent2 when Handle product inquiries.\nCall Agent3 when Offer shipping and delivery assistance.\nCall Agent4 when Provide technical support.\nCall Agent5 when Handle returns and exchanges.\nCall Agent6 when Offer after-sales support.\nCall Agent7 when Provide customer service.\nCall Agent8 when Offer customer education.\nCall Agent9 when Handle customer complaints.\nUse the assigned tools when the request needs their information.",
      "tools": [
        "Agent1",
        "Agent2",
        "Agent3",
        "Agent4",
        "Agent5",
        "Agent6",
        "Agent7",
        "Agent8",
        "Agent9",
        "https://api.you.com/mcp?profile=free",
        "https://mcp.deepwiki.com/mcp",
        "http://127.0.0.1:45186/mcp",
        "https://agenttools.wolfram.com/mcp"
      ]
    },
